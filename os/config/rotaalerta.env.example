# Configuração do provisionamento do RotaAlerta - Ubuntu Server
# Mantenha os valores como KEY=value, sem espaços ao redor do sinal de igual.

# Identidade do servidor
HOSTNAME_TARGET=rotaalerta-server

# Rede: dhcp (recomendado para VM) ou static.
# Em static, preencha interface, IP/CIDR e gateway com os dados da sua rede.
NETWORK_MODE=dhcp
NET_IFACE=auto
STATIC_IP_CIDR=
DEFAULT_GATEWAY=
DNS_SERVERS=1.1.1.1,8.8.8.8

# Firewall: yes habilita UFW liberando SSH, HTTP e HTTPS. Não habilite sem
# confirmar que a regra SSH corresponde à porta que você utiliza.
ENABLE_UFW=no
SSH_PORT=22

# Aplicação
APP_DIR=/opt/rotaalerta
APP_PORT=3000
APP_REPO_URL=
APP_REPO_SUBDIR=os/webapp

# Monitoramento
MONITOR_INTERVAL=30
CPU_THRESHOLD=85
MEMORY_THRESHOLD=85
DISK_THRESHOLD=85
